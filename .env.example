PRIM_API_KEY=
# PostgreSQL — utilisé par docker-compose et par DATABASE_URL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=retards_idf
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POLLING_INTERVAL_MINUTES=5
LOG_LEVEL=INFO
# Quota PRIM : 1 000 req/jour par flux. Temps réel : 1 req Estimated Timetable par relevé → 5 min de 6 h à minuit
# = 216 req/jour. Perturbations : 2 req Navitia toutes les 20 min = 108 req/jour.
# PERTURBATIONS_INTERVAL_MINUTES=20
# COLLECTE_HEURE_DEBUT=6
# SMIC horaire brut (€) servant au coût estimé — 12,31 € depuis le 1er juin 2026
# SMIC_HORAIRE=12.31
# Période de régénération des bilans /statistiques et /annee (minutes)
# BILANS_INTERVAL_MINUTES=10
# Alertes Telegram (voir ALERTES.md) — token de @BotFather et identifiant de la conversation
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Seuils (valeurs par défaut dans backend/config.py, calibrées par le backtest)
# ALERTE_SEUIL_EUROS=100000
# ALERTE_DUREE_INCIDENT_MIN=30
# ALERTE_RATIO_SEUIL_INCIDENT=0.8
# ALERTE_FENETRE_MIN=60
# ALERTE_MAX_JOUR=2
# ALERTE_DELAI_LIGNE_H=3
# ALERTE_SILENCE_DEBUT=22
# ALERTE_SILENCE_FIN=6
